# Isolated test runner for YOmux.
#
# Each run owns its HOME and writable container layer. The host HOME is never mounted, so
# tests cannot reach live YOmux, Claude, or Codex state through an overlooked call site.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore

# Chromium drives browser tests. procps and strace support process/namespace assertions;
# binutils supplies readelf for tmux build-id and coredump diagnostics.
ARG DEBIAN_SNAPSHOT=20260906T000439Z
ARG DEBIAN_SECURITY_SNAPSHOT=20260905T202337Z
COPY docker/debian-packages.txt /opt/debian-packages.txt
RUN sed -i \
      -e "s#http://deb.debian.org/debian-security#http://snapshot.debian.org/archive/debian-security/${DEBIAN_SECURITY_SNAPSHOT}#g" \
      -e "s#http://deb.debian.org/debian#http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}#g" \
      /etc/apt/sources.list.d/debian.sources \
 && printf '%s\n' 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot \
 && apt-get update \
 && xargs --no-run-if-empty apt-get install -y --no-install-recommends < /opt/debian-packages.txt \
 && rm -rf /var/lib/apt/lists/*

# Keep the build/test toolchain and dependency inputs inside the disposable image. Runtime test
# containers have no network, so a missing archive or module is a deterministic image-build error,
# not a late test-time download or a host-environment leak.
ARG BAZEL_VERSION=7.6.1
ARG BAZEL_SHA256=ac6249d1192aea9feaf49dfee2ab50c38cee2454b00cf29bbec985a11795c025
ARG BCR_COMMIT=7fe12e9bd4310220922969a5ef0f46474f6b3c33
ARG BCR_SHA256=6cd7f681f9711ed56973f6dca3d94192cc401a4a942b30eb64e0ecbf4a8b3208
ARG GO_VERSION=1.22.2
ARG GO_SHA256=5901c52b7a78002aeff14a21f93e0f064f74ce1360fce51c6ee68cd471216a17
RUN curl --fail --location --retry 3 --output /usr/local/bin/bazel \
      "https://github.com/bazelbuild/bazel/releases/download/${BAZEL_VERSION}/bazel-${BAZEL_VERSION}-linux-x86_64" \
 && echo "${BAZEL_SHA256}  /usr/local/bin/bazel" | sha256sum --check --status \
 && chmod 0755 /usr/local/bin/bazel

RUN curl --fail --location --retry 3 --output /tmp/go.tar.gz \
      "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
 && echo "${GO_SHA256}  /tmp/go.tar.gz" | sha256sum --check --status \
 && tar --extract --gzip --file /tmp/go.tar.gz --directory /usr/local \
 && rm -f /tmp/go.tar.gz
ENV PATH=/usr/local/go/bin:${PATH}

RUN mkdir -p /opt/yomux-bazel-registry \
 && curl --fail --location --retry 3 --output /tmp/bazel-central-registry.tar.gz \
      "https://github.com/bazelbuild/bazel-central-registry/archive/${BCR_COMMIT}.tar.gz" \
 && echo "${BCR_SHA256}  /tmp/bazel-central-registry.tar.gz" | sha256sum --check --status \
 && tar --extract --gzip --file /tmp/bazel-central-registry.tar.gz --strip-components=1 --directory /opt/yomux-bazel-registry \
 && rm -f /tmp/bazel-central-registry.tar.gz

# Match the Node major used by the source gate instead of Debian's older package.
COPY --from=node:22-trixie-slim@sha256:7b8a0c89c54499bee567618f96578e1a12a800f062fbdbfd1fb6a443fa6f6284 /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-trixie-slim@sha256:7b8a0c89c54499bee567618f96578e1a12a800f062fbdbfd1fb6a443fa6f6284 /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm

# Pin the agent clients and their transitive graph in the test image. Any future agent or stats
# E2E can use synthetic credentials and a local fake provider without mounting host client binaries
# or credentials. Install scripts remain enabled because these CLIs select their platform binary
# during installation; the lock fixes the package bytes and versions that those scripts consume.
COPY docker/agent-clients/package.json docker/agent-clients/package-lock.json /opt/yomux-agent-clients/
ENV PATH=/opt/yomux-agent-clients/node_modules/.bin:${PATH}
RUN cd /opt/yomux-agent-clients \
 && npm ci --no-audit --no-fund --omit=dev \
 && ln -sf /opt/yomux-agent-clients/node_modules/.bin/claude /usr/local/bin/claude \
 && ln -sf /opt/yomux-agent-clients/node_modules/.bin/codex /usr/local/bin/codex \
 && ln -sf /opt/yomux-agent-clients/node_modules/.bin/opencode /usr/local/bin/opencode \
 && command -v claude \
 && command -v codex \
 && command -v opencode

COPY docker/requirements-test.txt /opt/requirements-test.txt
RUN pip install --no-cache-dir \
      --requirement /opt/requirements-test.txt

ENV CHROME_BIN=/usr/bin/chromium \
    CHROMEDRIVER_BIN=/usr/bin/chromedriver

# Keep the pinned npm artifacts as a test-only provenance fixture for the tracked vendor bytes.
COPY package.json package-lock.json /opt/xterm/
RUN cd /opt/xterm && npm ci --ignore-scripts --no-audit --no-fund --omit=dev \
 && test -f /opt/xterm/node_modules/@xterm/xterm/lib/xterm.js \
 && test -f /opt/xterm/node_modules/@xterm/xterm/css/xterm.css \
 && test -f /opt/xterm/node_modules/@xterm/addon-unicode11/lib/addon-unicode11.js
COPY static/vendor/xterm.js static/vendor/xterm.css static/vendor/xterm-addon-unicode11.js /opt/yomux-xterm-vendor/
RUN cmp /opt/yomux-xterm-vendor/xterm.js /opt/xterm/node_modules/@xterm/xterm/lib/xterm.js \
 && cmp /opt/yomux-xterm-vendor/xterm.css /opt/xterm/node_modules/@xterm/xterm/css/xterm.css \
 && cmp /opt/yomux-xterm-vendor/xterm-addon-unicode11.js /opt/xterm/node_modules/@xterm/addon-unicode11/lib/addon-unicode11.js

# Keep source copies after the cache-independent test dependencies above. Go/Bazel prefetching
# still invalidates when this checkout's build graph changes, but client, Python, and xterm layers
# remain reusable across ordinary Go source edits.
COPY go.mod go.sum /opt/yomux-bazel-seed/
COPY .bazelversion MODULE.bazel BUILD.bazel WORKSPACE /opt/yomux-bazel-seed/
COPY cmd /opt/yomux-bazel-seed/cmd
COPY internal /opt/yomux-bazel-seed/internal
# The launcher supplies a temporary context containing only modules returned by `go mod download`
# for this checkout. The image build is deliberately fail-closed: the Go seed must be complete,
# and this layer may not reach a proxy to fill a missing module. That keeps a passing image tied to
# the declared checkout cache rather than an ambient network or host dependency.
COPY --from=go-mod-cache . /opt/yomux-go-mod-cache/
RUN mkdir -p /opt/yomux-go-mod-cache /opt/yomux-bazel-repository-cache \
      /opt/yomux-bazel-go-path /opt/yomux-bazel-go-cache \
 && cd /opt/yomux-bazel-seed \
 && GOWORK=off GO111MODULE=on GOPATH=/opt/yomux-bazel-go-path \
      GOMODCACHE=/opt/yomux-go-mod-cache GOCACHE=/opt/yomux-bazel-go-cache \
      GOPROXY=off GOSUMDB=off go mod download \
 && GOWORK=off GO111MODULE=on GOPATH=/opt/yomux-bazel-go-path \
      GOMODCACHE=/opt/yomux-go-mod-cache GOCACHE=/opt/yomux-bazel-go-cache \
      bazel --output_user_root=/opt/yomux-bazel-output \
        fetch \
        --registry=file:///opt/yomux-bazel-registry \
        --repository_cache=/opt/yomux-bazel-repository-cache \
        --repo_env=GO_REPOSITORY_USE_HOST_MODCACHE=1 \
        --repo_env=GOMODCACHE=/opt/yomux-go-mod-cache \
        --repo_env=GOPATH=/opt/yomux-bazel-go-path \
        --repo_env=GOCACHE=/opt/yomux-bazel-go-cache \
        @rules_go//go:def \
        @gazelle//:extensions.bzl \
        @com_github_mattn_go_sqlite3//:go_default_library \
        //cmd/yomux-go:yomux-go \
        //cmd/fake-llm:fake_llm \
 && GOWORK=off GO111MODULE=on GOPATH=/opt/yomux-bazel-go-path \
      GOMODCACHE=/opt/yomux-go-mod-cache GOCACHE=/opt/yomux-bazel-go-cache \
      bazel --output_user_root=/opt/yomux-bazel-output \
        build \
        --registry=file:///opt/yomux-bazel-registry \
        --repository_cache=/opt/yomux-bazel-repository-cache \
        --repo_env=GO_REPOSITORY_USE_HOST_MODCACHE=1 \
        --repo_env=GOMODCACHE=/opt/yomux-go-mod-cache \
        --repo_env=GOPATH=/opt/yomux-bazel-go-path \
        --repo_env=GOCACHE=/opt/yomux-bazel-go-cache \
        //cmd/yomux-go:yomux-go \
        //cmd/fake-llm:fake_llm \
 && chmod -R a+rX /opt/yomux-go-mod-cache /opt/yomux-bazel-repository-cache \
 && rm -rf /opt/yomux-bazel-seed /opt/yomux-bazel-go-path /opt/yomux-bazel-go-cache /opt/yomux-bazel-output

# Match host ownership for any explicit worktree writes made by tests.
ARG RUNNER_UID=1000
ARG RUNNER_GID=1000
RUN groupadd -o -g "${RUNNER_GID}" runner \
 && useradd -o -m -u "${RUNNER_UID}" -g "${RUNNER_GID}" -s /bin/bash runner

# Do not mask /home/runner with tmpfs at runtime. Tests require this baked-in local bin.
RUN mkdir -p /home/runner/.local/bin /home/runner/.local/share /home/runner/.local/state \
       /home/runner/.config /home/runner/.cache /home/runner/.codex \
  && chown -R runner:runner /home/runner

# These are image-owned inputs, never per-test workspaces. Make their read-only contract hold even
# for rootless Docker, where container UID 0 maps to the invoking host user and could otherwise
# mutate an image-backed cache in its writable container layer.
RUN chmod -R a-w /opt/yomux-go-mod-cache /opt/yomux-bazel-repository-cache /opt/yomux-bazel-registry

# This marker is part of the dedicated test-image identity. Container detection requires it in
# addition to the generic Docker marker and overlay root, so a developer container cannot silently
# bypass the outer runner's network, HOME, and source-mount boundary by setting one environment var.
RUN printf '%s\n' 'yomux-test-image-v1' > /opt/yomux-test-image.marker \
 && chmod 0444 /opt/yomux-test-image.marker

USER runner
ENV HOME=/home/runner
# YOmux is a Pacific product: the client stamps generated upload names with pacificDateStamp(), and
# yomux_lib/workspace/uploads.py and the server_time field in yomux_lib/app.py render ambient local
# time. A UTC container runs those paths on tomorrow's calendar day for the last 7-8 hours of every
# Pacific day, which made the generated-upload-filename assertion deterministically red after 5pm PT.
# Pinning here rather than passing -e TZ from docker/run-tests.sh puts the timezone inside the image
# fingerprint owned by tools/docker_image.py, so the tag changes and no stale UTC image is reused.
ENV TZ=America/Los_Angeles
ENV YOMUX_TEST_CONTAINER=1 YOLOMUX_TEST_CONTAINER=1
WORKDIR /w

# Fixture repositories need an identity; this config exists only in the throwaway HOME.
RUN git config --global user.email "runner@yomux.test" \
 && git config --global user.name "YOmux Test Runner" \
 && git config --global init.defaultBranch main \
 && git config --global --add safe.directory /w

# Fail the image build early when any required runtime dependency is absent, and when the container
# clock is not the Pacific clock the product and the tests assert against.
RUN python3 -c "import pytest, pytest_timeout, selenium, yaml, watchfiles, zoneinfo; zoneinfo.ZoneInfo('America/Los_Angeles')" \
 && python3 -c "import time; assert time.tzname == ('PST', 'PDT'), time.tzname" \
 && node -e "const assert = require('node:assert'); assert.equal(Intl.DateTimeFormat().resolvedOptions().timeZone, 'America/Los_Angeles'); assert.notEqual(new Date().getTimezoneOffset(), 0);" \
 && tmux -V \
 && readelf --version >/dev/null \
 && node --version | grep -q '^v22\.' \
 && chromium --version >/dev/null \
 && chromedriver --version >/dev/null \
 && go version >/dev/null

CMD ["bash", "-lc", "tmux -V; node --version; python3 -V; chromium --version; echo 'pass a command, e.g. python3 -m pytest tests/... -q'"]
