module(name = "yolomux")

bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "gazelle", version = "0.36.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
# Keep the compiler independent of the host package manager and runtime network access. The explicit
# archive map avoids rules_go's versions.json lookup when tests run with repository downloads disabled.
go_sdk.download(
    version = "1.22.2",
    sdks = {
        "linux_amd64": ["go1.22.2.linux-amd64.tar.gz", "5901c52b7a78002aeff14a21f93e0f064f74ce1360fce51c6ee68cd471216a17"],
        "linux_arm64": ["go1.22.2.linux-arm64.tar.gz", "36e720b2d564980c162a48c7e97da2e407dfcc4239e1e58d98082dfa2486a0c1"],
        "darwin_amd64": ["go1.22.2.darwin-amd64.tar.gz", "33e7f63077b1c5bce4f1ecadd4d990cf229667c40bfb00686990c950911b7ab7"],
        "darwin_arm64": ["go1.22.2.darwin-arm64.tar.gz", "660298be38648723e783ba0398e90431de1cb288c637880cdb124f39bd977f0d"],
    },
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_mattn_go_sqlite3")
