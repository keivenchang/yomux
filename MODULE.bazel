module(
    name = "yomux",
    bazel_compatibility = [
        ">=9.0.0",
        "<10.0.0",
    ],
)

bazel_dep(name = "rules_go", version = "0.64.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "platforms", version = "1.1.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# Keep the compiler independent of the host package manager and runtime network access. The explicit
# archive map avoids rules_go's versions.json lookup when tests run with repository downloads disabled;
# it also keeps local preview builds reproducible.
go_sdk.download(
    sdks = {
        "linux_amd64": [
            "go1.27.1.linux-amd64.tar.gz",
            "63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445",
        ],
        "linux_arm64": [
            "go1.27.1.linux-arm64.tar.gz",
            "3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec",
        ],
        "darwin_amd64": [
            "go1.27.1.darwin-amd64.tar.gz",
            "8f8f52c6649542cf027bbc9b9c68d1ec042f9f34808a40413f0b8b3f66f3caa4",
        ],
        "darwin_arm64": [
            "go1.27.1.darwin-arm64.tar.gz",
            "ee215d57e0ec269c60cc9ceca68e6bda321ba9ee5afe24f4b0988703c2d87d12",
        ],
    },
    version = "1.27.1",
)

# Go 1.27.1 retains the Mach-O UUIDs required by macOS local-network binaries.

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_mattn_go_sqlite3", "in_gopkg_yaml_v3", "org_golang_x_sys")
