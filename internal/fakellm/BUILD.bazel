load("@rules_go//go:def.bzl", "go_library")
load("//:tools/bazel_rules.bzl", "go_test_pair")

package(default_visibility = ["//:__subpackages__"])

exports_files(["BUILD.bazel"])

go_library(
    name = "fakellm_lib",
    testonly = True,
    srcs = ["server.go"],
    importpath = "github.com/keivenchang/yomux/internal/fakellm",
)

go_test_pair(
    name = "fakellm",
    srcs = ["server_test.go"],
    embed = [":fakellm_lib"],
)

filegroup(
    name = "qualified_sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/*.log",
            "**/*.lock",
            "product_version_generated.go",
        ],
    ),
    visibility = ["//:__pkg__"],
)
