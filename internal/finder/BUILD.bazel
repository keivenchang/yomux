load("@rules_go//go:def.bzl", "go_library")
load("//:tools/bazel_rules.bzl", "go_test_pair")

package(default_visibility = ["//:__subpackages__"])

exports_files(["BUILD.bazel"])

go_library(
    name = "finder_lib",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "github.com/keivenchang/yomux/internal/finder",
    deps = [
        "//internal/cache:cache_lib",
        "//internal/productenv:productenv_lib",
        "@org_golang_x_sys//unix",
    ],
)

go_test_pair(
    name = "finder",
    srcs = glob(["*_test.go"]),
    embed = [":finder_lib"],
)
