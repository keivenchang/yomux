package(default_visibility = ["//visibility:public"])

load("@rules_go//go:def.bzl", "go_library", "go_test")

SQLITE = "@com_github_mattn_go_sqlite3//:go_default_library"

go_library(
    name = "stats_lib",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/keivenchang/yolomux/internal/stats",
    deps = [SQLITE],
)

go_test(
    name = "stats_test",
    srcs = glob(["*_test.go"], exclude = ["agent_status_integration_test.go"]),
    data = [
        "//:go_test_support",
    ] + glob(["testdata/**"]),
    deps = [
        SQLITE,
        "//internal/testsupport:testsupport_lib",
    ],
    embed = [":stats_lib"],
)

go_test(
    name = "agent_status_integration_test",
    srcs = ["agent_status_integration_test.go"],
    data = [
        "//:go_test_support",
    ],
    deps = [
        SQLITE,
        "//internal/testsupport:testsupport_lib",
    ],
    embed = [":stats_lib"],
)

go_test(
    name = "stats_race_test",
    srcs = glob(["*_test.go"], exclude = ["agent_status_integration_test.go"]),
    data = [
        "//:go_test_support",
    ] + glob(["testdata/**"]),
    deps = [
        SQLITE,
        "//internal/testsupport:testsupport_lib",
    ],
    embed = [":stats_lib"],
    race = "on",
)

go_test(
    name = "agent_status_integration_race_test",
    srcs = ["agent_status_integration_test.go"],
    data = [
        "//:go_test_support",
    ],
    deps = [
        SQLITE,
        "//internal/testsupport:testsupport_lib",
    ],
    embed = [":stats_lib"],
    race = "on",
)
