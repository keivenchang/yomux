load("@rules_go//go:def.bzl", "go_library")
load("//:tools/bazel_rules.bzl", "go_test_pair")

package(default_visibility = ["//:__subpackages__"])

exports_files(["BUILD.bazel"])

SQLITE = "@com_github_mattn_go_sqlite3//:go_default_library"

go_library(
    name = "stats_lib",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    cgo = True,
    importpath = "github.com/keivenchang/yomux/internal/stats",
    deps = [
        "//internal/atomicfile:atomicfile_lib",
        "//internal/mutablefs:mutablefs_lib",
        "//internal/productenv:productenv_lib",
        "//internal/tailfile:tailfile_lib",
        "//internal/tmuxcmd:tmuxcmd_lib",
        SQLITE,
        "@org_golang_x_sys//unix",
    ],
)

go_test_pair(
    name = "stats",
    size = "medium",
    timeout = "moderate",
    srcs = glob(
        ["*_test.go"],
        exclude = ["agent_status_integration_test.go"],
    ),
    data = [
        "//:go_stats_test_support",
    ] + glob(["testdata/**"]),
    embed = [":stats_lib"],
    race_shard_count = 8,
    repo_root_runfile = "yomux/go_stats_test_support",
    shard_count = 8,
    deps = [
        SQLITE,
        "//internal/testsupport:testsupport_lib",
        "@in_gopkg_yaml_v3//:go_default_library",
    ],
)

go_test_pair(
    name = "agent_status_integration",
    srcs = ["agent_status_integration_test.go"],
    data = [
        "//:go_stats_test_support",
    ],
    embed = [":stats_lib"],
    repo_root_runfile = "yomux/go_stats_test_support",
    deps = [
        SQLITE,
        "//internal/testsupport:testsupport_lib",
    ],
)

filegroup(
    name = "qualified_sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/*.log",
            "**/*.lock",
            "product_version_generated.go",
        ],
    ),
    visibility = ["//:__pkg__"],
)
