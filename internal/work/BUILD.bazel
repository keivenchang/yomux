package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "docker_source_files",
    srcs = ["BUILD.bazel"] + glob(["**"], exclude = ["BUILD.bazel"]),
)

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "work_lib",
    srcs = ["scheduler.go"],
    importpath = "github.com/keivenchang/yolomux/internal/work",
)

go_test(
    name = "work_test",
    srcs = ["scheduler_test.go"],
    embed = [":work_lib"],
)

go_test(
    name = "work_race_test",
    srcs = ["scheduler_test.go"],
    embed = [":work_lib"],
    race = "on",
)
