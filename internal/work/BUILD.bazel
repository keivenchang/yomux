load("@rules_go//go:def.bzl", "go_library")
load("//:tools/bazel_rules.bzl", "go_test_pair")

package(default_visibility = ["//:__subpackages__"])

exports_files(["BUILD.bazel"])

go_library(
    name = "work_lib",
    srcs = [
        "context_mutex.go",
        "scheduler.go",
    ],
    importpath = "github.com/keivenchang/yomux/internal/work",
)

go_test_pair(
    name = "work",
    srcs = ["scheduler_test.go"],
    embed = [":work_lib"],
)

filegroup(
    name = "qualified_sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/*.log",
            "**/*.lock",
            "product_version_generated.go",
        ],
    ),
    visibility = ["//:__pkg__"],
)
