load("@rules_go//go:def.bzl", "go_library")
load("//:tools/bazel_rules.bzl", "go_test_pair")

package(default_visibility = ["//:__subpackages__"])

exports_files(["BUILD.bazel"])

go_library(
    name = "testsupport_lib",
    testonly = True,
    srcs = [
        "environment.go",
        "runfiles.go",
    ],
    importpath = "github.com/keivenchang/yomux/internal/testsupport",
    deps = [
        "//internal/productenv:productenv_lib",
        "@rules_go//go/runfiles",
    ],
)

go_test_pair(
    name = "testsupport",
    size = "small",
    srcs = [
        "environment_test.go",
        "runfiles_test.go",
    ],
    data = ["//:testsupport_runfiles"],
    embed = [":testsupport_lib"],
    repo_root_runfile = "yomux/testsupport_runfiles",
)
