load("@rules_go//go:def.bzl", "go_library")
load("//:tools/bazel_rules.bzl", "go_test_pair")

package(default_visibility = ["//:__subpackages__"])

exports_files(["BUILD.bazel"])

go_library(
    name = "capabilities_lib",
    srcs = ["catalog.go"],
    importpath = "github.com/keivenchang/yomux/internal/capabilities",
)

go_test_pair(
    name = "capabilities",
    srcs = ["catalog_test.go"],
    embed = [":capabilities_lib"],
)

filegroup(
    name = "qualified_sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/*.log",
            "**/*.lock",
            "product_version_generated.go",
        ],
    ),
    visibility = ["//:__pkg__"],
)
