load("@rules_go//go:def.bzl", "go_binary")

exports_files([
    "BUILD.bazel",
    "main.go",
])

go_binary(
    name = "versiongen",
    srcs = ["main.go"],
    visibility = ["//visibility:public"],
    deps = ["//internal/productversion:productversion_lib"],
)

filegroup(
    name = "qualified_sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.lock",
            "**/*.log",
        ],
    ),
    visibility = ["//:__pkg__"],
)
