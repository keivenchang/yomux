load("@rules_go//go:def.bzl", "go_binary", "go_test")

exports_files(["BUILD.bazel"])

go_binary(
    name = "staticgen",
    srcs = ["main.go"],
    visibility = ["//visibility:public"],
    deps = [
        "//internal/mutablefs:mutablefs_lib",
        "//internal/staticassets:staticassets_lib",
    ],
)

go_test(
    name = "staticgen_test",
    srcs = [
        "main.go",
        "main_test.go",
    ],
    deps = [
        "//internal/mutablefs:mutablefs_lib",
        "//internal/staticassets:staticassets_lib",
    ],
)

filegroup(
    name = "qualified_sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.lock",
            "**/*.log",
        ],
    ),
    visibility = ["//:__pkg__"],
)
