load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//:tools/bazel_rules.bzl", "go_test_pair", "product_version")

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel"])

SQLITE = "@com_github_mattn_go_sqlite3//:go_default_library"

product_version(
    name = "generate_product_version",
)

go_library(
    name = "yomux_go_lib",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ) + [":generate_product_version"],
    embedsrcs = glob(["pages/*.gohtml"]),
    importpath = "github.com/keivenchang/yomux/cmd/yomux-go",
    deps = [
        "//internal/atomicfile:atomicfile_lib",
        "//internal/cache:cache_lib",
        "//internal/capabilities:capabilities_lib",
        "//internal/chat:chat_lib",
        "//internal/decimal:decimal_lib",
        "//internal/finder:finder_lib",
        "//internal/locales:locales_lib",
        "//internal/mutablefs:mutablefs_lib",
        "//internal/productenv:productenv_lib",
        "//internal/productversion:productversion_lib",
        "//internal/staticassets:staticassets_lib",
        "//internal/stats:stats_lib",
        "//internal/tailfile:tailfile_lib",
        "//internal/tmuxcmd:tmuxcmd_lib",
        "//internal/work:work_lib",
        "//internal/yoagent:yoagent_lib",
        "//internal/yolo:yolo_lib",
        SQLITE,
        "@in_gopkg_yaml_v3//:go_default_library",
        "@org_golang_x_sys//unix",
    ],
)

go_binary(
    name = "yomux-go",
    embed = [":yomux_go_lib"],
)

alias(
    name = "yolomux_go",
    actual = ":yomux-go",
)

go_test_pair(
    name = "yomux_go",
    srcs = glob(
        ["*_test.go"],
        exclude = ["agent_window_browser_test.go"],
    ),
    data = ["//:go_cmd_test_support"],
    embed = [":yomux_go_lib"],
    race_shard_count = 4,
    repo_root_runfile = "yomux/go_cmd_test_support",
    shard_count = 4,
    deps = [
        "//internal/cache:cache_lib",
        "//internal/productenv:productenv_lib",
        "//internal/testsupport:testsupport_lib",
        SQLITE,
    ],
)

go_binary(
    name = "yomux_go_race",
    embed = [":yomux_go_lib"],
    race = "on",
)

go_test(
    name = "agent_window_browser_test",
    size = "medium",
    timeout = "moderate",
    srcs = ["agent_window_browser_test.go"],
    data = ["//:go_browser_runtime"],
    embed = [":yomux_go_lib"],
    env = {"YOMUX_REPO_ROOT_RUNFILE": "yomux/go_browser_runtime"},
    tags = [
        "cpu:8",
        "requires_chrome",
    ],
    deps = [
        "//internal/capabilities:capabilities_lib",
        "//internal/stats:stats_lib",
        "//internal/testsupport:testsupport_lib",
    ],
)

filegroup(
    name = "qualified_sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/*.log",
            "**/*.lock",
            "product_version_generated.go",
        ],
    ),
    visibility = ["//:__pkg__"],
)
