'use strict';
window.YOmuxShare = (() => {
  const syncIntervalMs = 1003;
  const inputQuietMs = 350;
  const readOnlyPresence = new WeakMap();
  async function request(url, options = {}, beforeDecode) {
    const response = await fetch(url, {credentials: 'same-origin', cache: 'no-store', ...options});
    if (response.ok && beforeDecode) await beforeDecode();
    const body = await response.json();
    if (!response.ok) throw Object.assign(new Error(body.error || 'Request failed'), {status: response.status, appearance: body.appearance});
    return body;
  }
  function post(url, body, beforeDecode) {
    return request(url, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)}, beforeDecode);
  }
  function randomID() { return crypto.randomUUID(); }
  function guestName() { const n = new Uint32Array(1); crypto.getRandomValues(n); return `Guest${String(n[0] % 10000).padStart(4, '0')}`; }
  function presenceExtension(api) {
    const effect = api.StateEffect.define();
    class RemoteCaret extends api.WidgetType {
      constructor(peer, color) { super(); this.peer = peer; this.color = color; }
      eq(other) {
        return this.peer.name === other.peer.name && this.color === other.color &&
          this.peer.approximate === other.peer.approximate && this.peer.follower === other.peer.follower;
      }
      toDOM() {
        const caret = document.createElement('span');
        caret.className = 'share-remote-caret';
        caret.dataset.shareCaretName = this.peer.name;
        if (this.peer.approximate) caret.dataset.shareCaretApproximate = '';
        if (this.peer.follower !== undefined) {
          caret.toggleAttribute('data-share-caret-follower', this.peer.follower);
          caret.toggleAttribute('data-share-caret-primary', !this.peer.follower);
        }
        caret.setAttribute('style', this.color);
        return caret;
      }
    }
    const field = api.StateField.define({
      create: () => api.Decoration.none,
      update(value, tr) {
        value = value.map(tr.changes);
        for (const item of tr.effects) if (item.is(effect)) {
          const ranges = [];
          for (const presence of item.value) {
            const anchor = Math.min(tr.newDoc.length, Math.max(0, presence.anchor));
            const head = Math.min(tr.newDoc.length, Math.max(0, presence.head));
            const color = shareParticipantStyle(presence);
            if ((!presence.follower || presence.showSelection) && !presence.approximate && head !== anchor) ranges.push(api.Decoration.mark({class: 'share-remote-selection', attributes: {style: color}}).range(Math.min(anchor, head), Math.max(anchor, head)));
            ranges.push(api.Decoration.widget({widget: new RemoteCaret(presence, color), side: 1}).range(head));
          }
          value = api.Decoration.set(ranges, true);
        }
        return value;
      },
      provide: owner => api.EditorView.decorations.from(owner),
    });
    let lastDoc, lastPeers;
    return {field, render(view, peers) {
      const signature = JSON.stringify(peers.map(({clientID, name, hue, owner, anchor, head, approximate, follower, showSelection}) =>
        [clientID, name, hue, owner, anchor, head, approximate, follower, showSelection]));
      if (lastDoc === view.state.doc && lastPeers === signature) return;
      lastDoc = view.state.doc;
      lastPeers = signature;
      view.dispatch({effects: effect.of(peers)});
    }};
  }
  function showReadOnlyPresence(view, peers) {
    let layer = readOnlyPresence.get(view);
    if (!layer) {
      if (!peers.length) return;
      const api = window.YOmuxCodeMirror;
      layer = presenceExtension(api);
      readOnlyPresence.set(view, layer);
      view.dispatch({effects: api.StateEffect.appendConfig.of(layer.field)});
    }
    layer.render(view, peers);
  }
  async function connect(view, url, options = {}) {
    const api = window.YOmuxCodeMirror;
    const client = randomID();
    const endpoint = new URL(url, location.origin); endpoint.searchParams.set('client', client);
    const initialURL = new URL(endpoint); initialURL.searchParams.set('initial', '1');
    const admission = new api.Compartment();
    view.dispatch({effects:api.StateEffect.appendConfig.of(admission.of(api.EditorState.readOnly.of(true)))});
    // Admission is read-only, so this is the editor's final text before joining.
    const draft = view.state.doc.toString();
    // YOmux passes a minimal replacement so carets and scroll survive joining. Plain callers replace the document.
    const replace = options.replacement || ((doc, text) => ({from: 0, to: doc.length, insert: text}));
    const alive = () => options.alive?.() !== false;
    function releaseAdmission() { if (alive()) view.dispatch({effects: admission.reconfigure([])}); }
    let initial;
    try { initial = await request(initialURL); } catch (error) { releaseAdmission(); throw error; }
    if (!alive() || options.current?.() === false) { releaseAdmission(); return null; }

    if (initial.active === false && initial.text === undefined) {releaseAdmission();return null;}
    // An unsaved draft can join only from the text it was based on. Its edits are replayed below.
    const carryDraft = options.draftBase !== undefined && draft !== options.draftBase;
    if (carryDraft && initial.text !== options.draftBase) {releaseAdmission();throw new Error('Save or reload the host draft before collaborating');}
    endpoint.searchParams.set('session',initial.session);
    const presence = presenceExtension(api);
    const compartment = new api.Compartment();
    if (draft !== initial.text) {
      view.dispatch({changes: replace(view.state.doc, initial.text), annotations:api.Transaction.addToHistory.of(false)});
    }
    view.dispatch({effects: [admission.reconfigure([]), api.StateEffect.appendConfig.of(compartment.of([api.collab({startVersion: initial.version, clientID: initial.clientID}), presence.field]))]});
    if (carryDraft) view.dispatch({changes: replace(view.state.doc, draft)});
    let closed = false, busy = false, timer = null, settled = Promise.resolve(), resolveSettled = null;
    let quietTimer = null, wakeQuiet = null, lastInput = 0, composing = false, flushers = 0;
    let lastDoc = view.state.doc, lastText = lastDoc.toString();
    let lastPresence;
    function refreshPresence() {
      if (!closed && lastPresence?.doc === view.state.doc) options.onPresence?.(lastPresence.peers);
    }
    const inputEvents = ['keydown', 'beforeinput', 'pointerdown', 'pointermove', 'compositionstart', 'compositionend', 'focusout'];
    function noteInput(event) {
      if (event.type === 'pointermove' && !event.buttons) return;
      if (event.type === 'compositionstart') composing = true;
      if (event.type === 'compositionend' || event.type === 'focusout') composing = false;
      lastInput = Date.now();
      if (wakeQuiet) checkQuiet();
    }
    const inputSurface = options.inputSurface || view.dom;
    inputEvents.forEach(type => inputSurface?.addEventListener?.(type, noteInput, true));
    let previewInputSurface;
    function syncPreviewInput() {
      const next = closed ? null : options.previewInputSurface?.();
      if (previewInputSurface === next) return;
      for (const type of inputEvents) {
        previewInputSurface?.removeEventListener(type, noteInput, true);
        next?.addEventListener(type, noteInput, true);
      }
      if (previewInputSurface && composing) noteInput({type: 'focusout'});
      previewInputSurface = next;
    }
    syncPreviewInput();
    function checkQuiet() {
      clearTimeout(quietTimer);
      quietTimer = null;
      const delay = lastInput + inputQuietMs - Date.now();
      if (!closed && !flushers && composing) return;
      if (!closed && !flushers && delay > 0) {
        quietTimer = setTimeout(checkQuiet, delay);
        return;
      }
      const resolve = wakeQuiet;
      wakeQuiet = null;
      resolve?.();
    }
    function waitForQuiet() {
      if (closed || flushers || (!composing && Date.now() >= lastInput + inputQuietMs)) return;
      return new Promise(resolve => { wakeQuiet = resolve; checkQuiet(); });
    }
    const ids = new WeakMap();
    function opID(update) { let id = ids.get(update.origin); if (!id) { id = randomID(); ids.set(update.origin, id); } return id; }
    async function tick() {
      if (closed) return;
      if (busy) return settled;
      clearTimeout(timer);
      timer = null;
      busy = true;
      settled=new Promise(resolve=>{resolveSettled=resolve;});
      try {
        await waitForQuiet();
        if (closed || options.current?.() === false) { stop(); return; }
        const version = api.getSyncedVersion(view.state);
        const sendable = api.sendableUpdates(view.state);
        const pending = sendable.slice(0, 256);
        const selection = options.selection?.() || view.state.selection.main;
        const canPublishSelection = sendable.length === pending.length;
        const response = await post(endpoint, {
          version, updates: pending.map(update => ({changes: update.changes.toJSON(), id: opID(update)})),
          anchor: canPublishSelection ? selection.anchor : -1, head: canPublishSelection ? selection.head : -1,
          surface: selection.surface || 'text', approximate: selection.approximate === true,
          focused: (selection.focused ?? view.hasFocus) && !document.hidden,
        }, waitForQuiet);
        await waitForQuiet();
        if (closed || options.current?.() === false) { stop(); return; }
        if (response.updates.length) view.dispatch(api.receiveUpdates(view.state, response.updates.map(update => ({...update, changes: api.ChangeSet.fromJSON(update.changes)}))));
        // Server positions are at the accepted revision; map through this editor's
        // outstanding local changes before drawing another editor's selection.
        const outstanding = api.sendableUpdates(view.state);
        const appliedVersion = api.getSyncedVersion(view.state);
        const atServerVersion = appliedVersion === response.version;
        const visiblePeers = atServerVersion ? response.presence : [];
        const peers = visiblePeers.filter(peer => peer.clientID !== initial.clientID).map(peer => {
          let {anchor, head} = peer;
          for (const local of outstanding) { anchor = local.changes.mapPos(anchor); head = local.changes.mapPos(head); }
          return {...peer, anchor, head};
        });
        presence.render(view, options.sourcePresence ? peers.map(options.sourcePresence) : peers);
        if (view.state.doc !== lastDoc) {
          lastDoc = view.state.doc;
          lastText = lastDoc.toString();
        }
        options.onState?.({...response, version: appliedVersion, saved: response.saved && atServerVersion && outstanding.length === 0}, lastText);
        lastPresence = {doc: view.state.doc, peers};
        refreshPresence();
        if (!response.active) stop();
      } catch (error) {
        const ended = error.status === 410 || error.status === 401 || error.status === 403 ||
          ['document_session_changed', 'permission_changed'].includes(error.message);
        if (!ended) await waitForQuiet();
        if (closed) return;
        options.onError?.(error);
        if (ended) {
          options.onEnd?.(error);
          stop();
        }
      } finally { busy = false; resolveSettled(); if (!closed) timer = setTimeout(tick, syncIntervalMs); }
    }
    function stop() {
      if (closed) return;
      closed = true;
      clearTimeout(timer);
      checkQuiet();
      inputEvents.forEach(type => inputSurface?.removeEventListener?.(type, noteInput, true));
      syncPreviewInput();
      if (alive()) view.dispatch({effects: compartment.reconfigure([])});
    }
    async function flush() {
      flushers++;
      checkQuiet();
      try {
        await tick();
        if (!closed && api.sendableUpdates(view.state).length) await tick();
        return !closed && api.sendableUpdates(view.state).length === 0;
      } finally { flushers--; }
    }
    tick();
    return {stop, session:initial.session, pending:()=>closed?0:api.sendableUpdates(view.state).length, text:()=>view.state.doc.toString(), flush, refreshPresence, syncPreviewInput, resolve: () => post(endpoint, {version: api.getSyncedVersion(view.state), updates: [], resolve: 'resume'})};
  }
  return {request, post, connect, showReadOnlyPresence, randomID, guestName};
})();
