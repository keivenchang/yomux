package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "docker_source_files",
    srcs = ["BUILD.bazel"] + glob(["**"], exclude = ["BUILD.bazel"]),
)

load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "fake_llm_lib",
    srcs = ["main.go"],
    importpath = "github.com/keivenchang/yolomux/cmd/fake-llm",
    deps = ["//internal/fakellm:fakellm_lib"],
)

go_binary(
    name = "fake_llm",
    embed = [":fake_llm_lib"],
)
