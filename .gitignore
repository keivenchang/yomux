.uploads
__pycache__/
*.py[cod]
.DS_Store
.venv/
node_modules/
bazel-*
# Required source pin, rather than generated Bazel output.
!/docker/bazel-registry.json
/instance.lock
/yolomux-go
/static/yolomux.css
/static/yolomux.js
/static/yomux.css
/static/yomux.js

# Scratch worklists — never committed (kept local only)
DOIT*.md

# Machine-local Selenium golden baselines and failure diffs. Refresh with
# YOLOMUX_UPDATE_GOLDENS=1; screenshots are intentionally never source.
.yolomux-test-goldens/

# Transient browser test fixture pages served from repo root (Chrome 150 HTTP fixtures)
.browser-fixture-*

# Local diagnostic logs from production and test launches.
*.log
*.log.old

# Local crash dumps.
core
# Generated Bazel output directories.
bazel-*/

# PDF.js is checksum-pinned and fetched by make setup/build.
/static/vendor/pdfjs/
/static/vendor/.pdfjs-*/

# Pinned browser dependencies and reproducible build outputs.
/static/vendor/*.js
/static/vendor/*.css
/static/vendor/katex/*.js
/static/vendor/katex/*.css
/static/vendor/katex/fonts/
/static/fonts/*.woff2
/static/codemirror.js
/static/prosemirror.js
/static/emoji-data.js
/static/locales/
