genrule(
    name = "yolomux_go",
    srcs = glob(["cmd/yolomux-go/*.go", "internal/**/*.go"]),
    outs = ["yolomux-go"],
    cmd = "mkdir -p $(@D)/go-cache && GOWORK=off GO111MODULE=on GOCACHE=$$(pwd)/$(@D)/go-cache go build -buildvcs=false -trimpath -o $@ ./cmd/yolomux-go",
    local = True,
    tags = ["manual"],
)

genrule(
    name = "yolomux_go_race",
    srcs = glob(["cmd/yolomux-go/*.go", "internal/**/*.go"]),
    outs = ["yolomux-go-race"],
    cmd = "mkdir -p $(@D)/go-cache && GOWORK=off GO111MODULE=on GOCACHE=$$(pwd)/$(@D)/go-cache go test -race -c -o $@ ./cmd/yolomux-go",
    local = True,
    tags = ["manual"],
)

test_suite(
    name = "go_tests",
    tests = [":yolomux_go_contract_test"],
)

sh_test(
    name = "yolomux_go_race_test",
    srcs = ["tools/bazel_go_race_test.sh"],
    data = [":yolomux_go_race"],
    args = ["$(location :yolomux_go_race)"],
)

sh_test(
    name = "yolomux_go_contract_test",
    srcs = ["tools/bazel_go_contract_test.sh"],
    data = [":yolomux_go"],
    args = ["$(location :yolomux_go)"],
)
