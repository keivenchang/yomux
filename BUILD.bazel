alias(
    name = "yolomux_go",
    actual = "//cmd/yolomux-go:yolomux_go",
)

alias(
    name = "fake_llm",
    actual = "//cmd/fake-llm:fake_llm",
)

# These are runtime inputs for native Go tests that invoke the repository's Python fixtures. The
# files remain declared data rather than being discovered through the host checkout.
filegroup(
    name = "go_test_support",
    visibility = ["//visibility:public"],
    srcs = glob([
        "tools/**/*.py",
        "tests/fixtures/current_model_usage/**/*.jsonl",
        "yolomux_lib/**/*.json",
        "yolomux_lib/**/*.py",
    ]),
)

filegroup(
    name = "docker_bazel_test_data",
    srcs = [
        ".bazelversion",
        ".dockerignore",
        "BUILD.bazel",
        "MODULE.bazel",
        "WORKSPACE",
        "conftest.py",
        "docker/Dockerfile.test",
        "docker/debian-packages.txt",
        "docker/run-tests.sh",
        "docker/agent-clients/package.json",
        "docker/agent-clients/package-lock.json",
        "go.mod",
        "go.sum",
        "package.json",
        "package-lock.json",
        "pyproject.toml",
        "docker/requirements-test.txt",
    ] + glob([
        "static/**",
        "static_src/**",
        "tests/**",
        "tools/**",
        "yolomux_lib/**",
    ], exclude = [
        "**/__pycache__/**",
        "**/*.pyc",
    ]),
)

test_suite(
    name = "go_unit_tests",
    tests = [
        "//cmd/yolomux-go:yolomux_go_test",
        "//internal/capabilities:capabilities_test",
        "//internal/fakellm:fakellm_test",
        "//internal/finder:finder_test",
        "//internal/stats:stats_test",
        "//internal/stats:agent_status_integration_test",
        "//internal/work:work_test",
    ],
)

test_suite(
    name = "go_race_tests",
    tests = [
        "//cmd/yolomux-go:yolomux_go_race_test",
        "//internal/capabilities:capabilities_race_test",
        "//internal/fakellm:fakellm_race_test",
        "//internal/finder:finder_race_test",
        "//internal/stats:stats_race_test",
        "//internal/stats:agent_status_integration_race_test",
        "//internal/work:work_race_test",
    ],
)

test_suite(
    name = "go_tests",
    tests = [
        ":go_unit_tests",
        ":go_race_tests",
        ":yolomux_go_contract_test",
        ":bazel_action_environment_test",
        ":docker_runtime_contract_test",
        ":yolomux_go_browser_e2e",
        ":yolomux_go_stats_browser_docker_e2e",
        ":agent_status_docker_e2e",
    ],
)

sh_test(
    name = "yolomux_go_contract_test",
    srcs = ["tools/bazel_go_contract_test.sh"],
    data = [":yolomux_go"],
    args = ["$(location :yolomux_go)"],
)

sh_test(
    name = "bazel_action_environment_test",
    srcs = ["tools/bazel_action_environment_test.sh"],
)

sh_test(
    name = "docker_runtime_contract_test",
    srcs = ["tools/docker_runtime_contract_test.sh"],
)

sh_test(
    name = "yolomux_go_browser_e2e",
    srcs = ["tools/run_go_browser_e2e.sh"],
    data = [
        ":yolomux_go",
        ":docker_bazel_test_data",
        "tools/bazel_go_browser_e2e.py",
        "tests/browser_helpers/__init__.py",
        "tests/browser_helpers/webdriver_lease.py",
    ],
    args = ["$(location :yolomux_go)", "$(location tools/bazel_go_browser_e2e.py)"],
    tags = ["local", "no-sandbox"],
)

sh_test(
    name = "yolomux_go_stats_browser_docker_e2e",
    srcs = ["tools/bazel_go_stats_browser_docker_e2e.sh"],
    data = [
        ":yolomux_go",
        ":docker_bazel_test_data",
    ],
    args = ["$(location :yolomux_go)"],
    local = True,
    tags = ["local", "no-sandbox"],
)

sh_test(
    name = "agent_status_docker_e2e",
    srcs = ["tools/bazel_agent_status_docker_e2e.sh"],
    data = [":docker_bazel_test_data"],
    args = ["$(location tools/bazel_agent_status_docker_e2e.sh)"],
    local = True,
    tags = ["local", "no-sandbox"],
)
