# This inventory covers every executable step in test_plan.StepId. Whitespace
# and Git revision/dirty-state checks remain in the host orchestration layer.
QUALIFIED_GATE_STEPS = [
    "py-compile",
    "static-build",
    "textshape",
    "architecture-budgets",
    "local-service-types",
    "node-yomux-syntax",
    "node-wall-syntax",
    "node-layout",
    "pytest-nonbrowser",
    "pytest-gate-serial",
    "pytest-boot",
    "pytest-browser",
    "pytest-browser-golden",
    "pytest-e2e",
]

[native_python_test(
    name = "qualified_" + step.replace("-", "_"),
    size = "large",
    timeout = "long",
    arguments = [step],
    data = [":yomux-go"] if step.startswith("pytest-") else [],
    runtime_groups = (["node"] if step.startswith("node-") else []) if not step.startswith("pytest-") else [
        "node",
        "go",
        "git_tmux",
        "browsers",
        "clients",
        "compiler",
        "xterm",
    ],
    script = "tools/bazel_native_step.py",
    tags = ["manual"],
    tree = ":qualified_gate_runtime",
) for step in QUALIFIED_GATE_STEPS]

native_python_test(
    name = "qualified_pytest_direct",
    size = "large",
    timeout = "long",
    arguments = ["pytest-direct"],
    data = [":yomux-go"],
    script = "tools/bazel_native_step.py",
    tags = ["manual"],
    tree = ":qualified_gate_runtime",
)
