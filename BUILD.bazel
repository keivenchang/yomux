sh_test(
    name = "yolomux_go_contract_test",
    srcs = ["tools/bazel_go_contract_test.sh"],
    data = [":yolomux_go"],
    args = ["$(location :yolomux_go)"],
)

genrule(
    name = "yolomux_go_agent_status_integration_test",
    srcs = glob([
        "cmd/yolomux-go/*.go",
        "internal/**/*.go",
        "tools/mockers/*.py",
    ]) + ["go.mod", "go.sum"],
    outs = ["yolomux-go-agent-status-integration.ok"],
    cmd = "mkdir -p $(@D)/go-cache $(@D)/go-path $(@D)/go-mod-cache && GOWORK=off GO111MODULE=on GOPATH=$$(pwd)/$(@D)/go-path GOMODCACHE=$$(pwd)/$(@D)/go-mod-cache GOCACHE=$$(pwd)/$(@D)/go-cache go test -race -count=1 ./internal/stats -run '^TestAgentStatusLinuxAdaptersWithMockClient$$' && touch $@",
    local = True,
    tags = ["manual", "local"],
)

