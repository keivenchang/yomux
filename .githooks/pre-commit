#!/usr/bin/env bash
# Build and validate staged static source in an isolated candidate tree. Generated bundles stay out
# of Git; this proves the committed source can produce the files each serving path consumes.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
if git -C "$repo_root" diff --cached --quiet -- static_src/ tools/static_build.py .githooks/pre-commit static/yolomux.js; then
    exit 0
fi

index_root="$(mktemp -d "${TMPDIR:-/tmp}/yolomux-static-hook.XXXXXX")"
cleanup() {
    rm -rf "$index_root"
}
trap cleanup EXIT HUP INT TERM

index_tree="$(git -C "$repo_root" write-tree)"
git -C "$repo_root" archive --format=tar "$index_tree" | tar -xf - -C "$index_root"
git_dir="$(git -C "$repo_root" rev-parse --absolute-git-dir)"
printf 'gitdir: %s\n' "$git_dir" > "$index_root/.git"
python3 "$index_root/tools/static_build.py"
python3 "$index_root/tools/static_build.py" --check
